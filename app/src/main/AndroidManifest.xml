<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="cl.itatagroup.canales">
  <uses-feature android:name="android.software.leanback" android:required="false"/>
  <uses-feature android:name="android.hardware.touchscreen" android:required="false"/>
  <!-- Para recibir el video de los canales. Es lo único que la app hace por internet. -->
  <uses-permission android:name="android.permission.INTERNET"/>
  <!-- Media3 consulta si hay red y de qué tipo, para elegir la calidad inicial. No sale del equipo. -->
  <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
  <!-- Solo para «Buscar actualización», que se pulsa a mano: la app nunca consulta sola, y Android
       siempre pide confirmar la instalación. -->
  <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES"/>
  <application android:label="@string/app_name" android:banner="@drawable/banner" android:icon="@drawable/banner"
      android:allowBackup="false" android:theme="@android:style/Theme.DeviceDefault.NoActionBar.Fullscreen">
    <activity android:name=".Reproductor" android:exported="true" android:screenOrientation="landscape"
        android:configChanges="keyboard|keyboardHidden|navigation|screenSize|orientation">
      <intent-filter>
        <action android:name="android.intent.action.MAIN"/>
        <category android:name="android.intent.category.LAUNCHER"/>
        <category android:name="android.intent.category.LEANBACK_LAUNCHER"/>
      </intent-filter>
    </activity>
    <!-- Resultado de la sesión de instalación de una actualización. Solo le llega el PendingIntent propio. -->
    <receiver android:name="cl.itatagroup.actualizacion.ResultadoInstalacion" android:exported="false"/>
  </application>
</manifest>
